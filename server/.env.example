# Server Configuration
PORT=3002
NODE_ENV=development

# Database
DB_PATH=./db/alis-form-markup.db

# OCR Configuration
OCR_LANG=eng
OCR_TIMEOUT=60000

# File Storage
JOBS_DIR=./jobs
ARCHIVE_DIR=./archived

# HubSpot Integration (Private App access token)
# Create one at: HubSpot → Settings → Integrations → Private Apps
HUBSPOT_ACCESS_TOKEN=your_private_app_token_here
